{
  "rewrites": [{ "source": "/admin", "destination": "/admin.html" }],
  "functions": { "api/app.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss://zioazzlxzksaxmndkulh.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/admin(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
